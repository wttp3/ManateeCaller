PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Microsoft SQL Server (local Docker example)
DATABASE_URL=Server=localhost,1433;Database=ManateeCaller;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true

# Meta WhatsApp Cloud API — replace with your own values locally; never commit real secrets
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=replace-with-your-access-token
WHATSAPP_APP_SECRET=replace-with-your-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-your-verify-token
WHATSAPP_TEMPLATE_NAME=manatee_invite
WHATSAPP_API_VERSION=v22.0

# ElevenLabs speech-to-text
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
ELEVENLABS_ENABLE_ZERO_RETENTION=false

# 32-byte keys as 64-character hex strings — generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TILE_HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
LOOKUP_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

SESSION_TIMEOUT_HOURS=24
MAX_VOICE_NOTE_BYTES=16777216
MAX_VOICE_NOTE_SECONDS=120
TEMP_AUDIO_DIR=./tmp/audio
JOB_POLL_INTERVAL_MS=2000
