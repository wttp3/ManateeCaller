PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Microsoft SQL Server (local Docker example)
DATABASE_URL=Server=localhost,1433;Database=ManateeCaller;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true

# Meta WhatsApp Cloud API — replace with your own values locally; never commit real secrets
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<your-business-account-id>
WHATSAPP_ACCESS_TOKEN=<your-token>
WHATSAPP_APP_SECRET=<your-app-secret>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<your-verify-token>
WHATSAPP_TEMPLATE_NAME=manatee_invite
WHATSAPP_API_VERSION=v22.0

# Phase 1 pilot. Template invites stay off until a template is approved.
# Signup does not send one while this is false.
WHATSAPP_TEMPLATE_INVITES_ENABLED=false

# Inbound keyword that opens the 24-hour window and starts consent plus the session.
OPT_IN_KEYWORD=I'm in

# Inbound keyword, from the sender's own number, that deletes their rows.
# Case and extra spaces are ignored. STOP / unsubscribe / cancel / opt out opt out instead.
ERASURE_KEYWORD=DELETE MY DATA

# Optional. If set, POST /api/erasure requires Authorization: Bearer <token>.
# If unset, that route is disabled. Participants erase by texting the keyword.
# ERASURE_ADMIN_TOKEN=

# Comma-separated E.164 numbers. Empty ignores every inbound message and refuses every outbound send.
PILOT_ALLOWED_SENDERS=

# Set either to stop the background worker from polling (deploy smoke, one-off tasks).
# DEPLOY_SMOKE_MODE=1
# DISABLE_BACKGROUND_JOBS=1

# ElevenLabs speech-to-text
ELEVENLABS_API_KEY=<your-elevenlabs-key>
ELEVENLABS_ENABLE_ZERO_RETENTION=false

# 32-byte keys as 64-character hex strings — generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=<64-hex-chars>
TILE_HMAC_KEY=<64-hex-chars>
LOOKUP_HMAC_KEY=<64-hex-chars>

SESSION_TIMEOUT_HOURS=24
MAX_VOICE_NOTE_BYTES=16777216
MAX_VOICE_NOTE_SECONDS=120
TEMP_AUDIO_DIR=./tmp/audio
JOB_POLL_INTERVAL_MS=2000
